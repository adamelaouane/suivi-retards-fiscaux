# انسخ هذا الملف إلى .env واملأ القيم
# cp .env.example .env

# مفتاح سري قوي — لا ترفع ملف .env أبدًا
# توليد مفتاح:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# وضع التطوير (True فقط على جهازك المحلي)
FLASK_DEBUG=False

